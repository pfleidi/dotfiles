worktree-path = '''{% raw %}{% set home = {% endraw %}{{ (env.HOME ~ "/") | json_encode() }}{% raw %} %}~/worktrees/{{ (repo_path[(home | length):] if repo_path[:(home | length)] == home else repo_path) | sanitize_hash }}/{{ branch | sanitize }}{% endraw %}'''

[pre-start]
tmp = '''
mkdir -p tmp &&
  { git check-ignore -q tmp/probe || echo '/tmp/' >> "$(git rev-parse --git-path info/exclude)"; }
'''
