[include]
	path = ~/.config/git/config.local

[alias]
	co = checkout
	ci = commit
	st = status
	br = branch
	rmrb = "push --delete origin"
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
	branch-cleanup = !git branch --merged main | grep -v main | xargs -n 1 git branch -d

[rerere]
	enabled = true
	autoupdate = true

[credential]
	helper = osxkeychain

[core]
	autocrlf = input
	pager = delta --dark

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[delta]
	side-by-side = true

[diff]
	algorithm = histogram
