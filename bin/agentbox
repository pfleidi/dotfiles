#!/bin/sh

set -eu

machine=workbox
script=$(realpath "$0")
repo=$(dirname "$(dirname "$script")")
config_root=${XDG_CONFIG_HOME:-"$HOME/.config"}/agentbox
manifest=$config_root/repos
machine_template=$repo/config/agentbox/$machine.json
key_dir=$config_root/keys/$machine
private_key=$key_dir/github_ed25519
public_key=$private_key.pub
key_title_file=$private_key.title
ssh_dir=$HOME/.ssh
ssh_alias=$ssh_dir/config.d/agentbox
ssh_config=$ssh_dir/config

usage() {
  cat >&2 <<'EOF'
Usage:
  agentbox create
  agentbox key
  agentbox sync-repos DIRECTORY
  agentbox shell [COMMAND...]
  agentbox start
  agentbox stop
  agentbox status
  agentbox rebuild
EOF
  exit 2
}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "Required command is missing: $1"
  fi
}

require_macos() {
  if [ "$(uname -s)" != Darwin ]; then
    fail 'This command requires macOS.'
  fi
}

require_orb() {
  require_macos
  require_command orb
}

load_machine_template() {
  require_command jq
  [ -f "$machine_template" ] && [ -r "$machine_template" ] || fail 'The workbox machine template is missing from the dotfiles repository.'

  if ! jq -e '
    type == "object" and
    (keys | sort) == ["architecture", "cpus", "disk_gib", "distribution", "memory_mib"] and
    (.distribution | type == "string" and length > 0) and
    (.architecture == "arm64" or .architecture == "amd64") and
    (.cpus | type == "number" and . == floor and . >= 1) and
    (.memory_mib | type == "number" and . == floor and . >= 512) and
    (.disk_gib | type == "number" and . == floor and . >= 1)
  ' "$machine_template" >/dev/null; then
    fail 'The workbox machine template is invalid.'
  fi

  distribution=$(jq -r .distribution "$machine_template")
  architecture=$(jq -r .architecture "$machine_template")
  cpu_limit=$(jq -r .cpus "$machine_template")
  memory_limit_mib=$(jq -r .memory_mib "$machine_template")
  disk_limit_gib=$(jq -r .disk_gib "$machine_template")

  case $distribution in
    *[!A-Za-z0-9_.:-]*)
      fail 'The workbox template distribution is invalid.'
      ;;
  esac
  disk_limit_bytes=$((disk_limit_gib * 1024 * 1024 * 1024))
}

normalize_github_remote() {
  remote=$1

  case $remote in
    https://github.com/*)
      path=${remote#https://github.com/}
      ;;
    git@github.com:*)
      path=${remote#git@github.com:}
      ;;
    ssh://git@github.com/*)
      path=${remote#ssh://git@github.com/}
      ;;
    *)
      return 1
      ;;
  esac

  case $path in
    *.git)
      path=${path%.git}
      ;;
  esac

  owner=${path%%/*}
  repository=${path#*/}
  if [ "$repository" = "$path" ] || [ -z "$owner" ] || [ -z "$repository" ]; then
    return 1
  fi
  case $repository in
    */*)
      return 1
      ;;
  esac
  case $owner in
    .|..|*[!A-Za-z0-9_.-]*)
      return 1
      ;;
  esac
  case $repository in
    .|..|*[!A-Za-z0-9_.-]*)
      return 1
      ;;
  esac

  printf 'git@github.com:%s/%s.git\n' "$owner" "$repository"
}

repository_remote() {
  repository_dir=$1
  remotes=$(git -C "$repository_dir" remote 2>/dev/null) || return 1

  for remote_name in $remotes; do
    urls=$(git -C "$repository_dir" remote get-url --all "$remote_name" 2>/dev/null) || return 1
    for remote_url in $urls; do
      case $remote_url in
        http://*@github.com/*|https://*@github.com/*)
          return 2
          ;;
      esac
    done
  done

  if git -C "$repository_dir" remote get-url origin >/dev/null 2>&1; then
    remote_url=$(git -C "$repository_dir" remote get-url origin 2>/dev/null) || return 1
    if normalized=$(normalize_github_remote "$remote_url"); then
      printf '%s\n' "$normalized"
      return
    fi
  fi

  old_ifs=$IFS
  IFS='
'
  for remote_name in $(printf '%s\n' "$remotes" | LC_ALL=C sort); do
    [ "$remote_name" = origin ] && continue
    remote_url=$(git -C "$repository_dir" remote get-url "$remote_name" 2>/dev/null) || {
      IFS=$old_ifs
      return 1
    }
    if normalized=$(normalize_github_remote "$remote_url"); then
      IFS=$old_ifs
      printf '%s\n' "$normalized"
      return
    fi
  done
  IFS=$old_ifs

  return 1
}

sync_repositories() {
  [ "$#" -eq 1 ] || usage
  source_directory=$1
  [ -d "$source_directory" ] || fail 'Repository source must be a directory.'

  require_command git
  require_command find
  require_command sort

  mkdir -p "$config_root"
  chmod 700 "$config_root"
  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/agentbox-sync.XXXXXX")
  trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
  repositories=$work_dir/repositories
  discovered=$work_dir/discovered
  seen=$work_dir/seen
  : >"$discovered"
  : >"$seen"

  if ! find "$source_directory" -type d \
    -exec sh -c 'test -e "$1/.git"' sh {} \; \
    -print -prune >"$repositories"; then
    fail 'Repository discovery failed.'
  fi
  if [ ! -s "$repositories" ]; then
    fail 'No Git working trees were found.'
  fi

  while IFS= read -r repository_dir; do
    if normalized=$(repository_remote "$repository_dir"); then
      :
    else
      status=$?
      if [ "$status" -eq 2 ]; then
        fail 'A repository has an HTTP remote with embedded credentials.'
      fi
      fail 'A repository has no supported GitHub remote.'
    fi

    clone_name=${normalized##*/}
    clone_name=${clone_name%.git}
    existing=$(awk -F '\t' -v name="$clone_name" '$1 == name { print $2; exit }' "$seen")
    if [ -n "$existing" ] && [ "$existing" != "$normalized" ]; then
      fail 'Different repositories would clone to the same directory name.'
    fi
    if [ -z "$existing" ]; then
      printf '%s\t%s\n' "$clone_name" "$normalized" >>"$seen"
    fi
    printf '%s\n' "$normalized" >>"$discovered"
  done <"$repositories"

  manifest_tmp=$(mktemp "$config_root/.repos.XXXXXX")
  if ! LC_ALL=C sort -u "$discovered" >"$manifest_tmp"; then
    rm -f "$manifest_tmp"
    fail 'Could not sort the repository manifest.'
  fi
  chmod 600 "$manifest_tmp"
  if ! mv -f "$manifest_tmp" "$manifest"; then
    rm -f "$manifest_tmp"
    fail 'Could not replace the repository manifest.'
  fi
  trap - EXIT HUP INT TERM
  rm -rf "$work_dir"
}

validate_manifest() {
  [ -f "$manifest" ] && [ -r "$manifest" ] || fail 'Run agentbox sync-repos DIRECTORY before creating the machine.'
  [ -s "$manifest" ] || fail 'The repository manifest is empty.'

  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/agentbox-manifest.XXXXXX")
  trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
  seen=$work_dir/seen
  : >"$seen"
  while IFS= read -r remote_url; do
    [ -n "$remote_url" ] || fail 'The repository manifest contains an empty entry.'
    normalized=$(normalize_github_remote "$remote_url") || fail 'The repository manifest contains an unsupported remote.'
    [ "$normalized" = "$remote_url" ] || fail 'The repository manifest contains a non-normalized remote.'
    clone_name=${normalized##*/}
    clone_name=${clone_name%.git}
    existing=$(awk -F '\t' -v name="$clone_name" '$1 == name { print $2; exit }' "$seen")
    if [ -n "$existing" ] && [ "$existing" != "$normalized" ]; then
      fail 'The repository manifest contains a destination collision.'
    fi
    if [ -z "$existing" ]; then
      printf '%s\t%s\n' "$clone_name" "$normalized" >>"$seen"
    fi
  done <"$manifest"
  trap - EXIT HUP INT TERM
  rm -rf "$work_dir"
}

gh_stored() {
  env -u GH_TOKEN -u GITHUB_TOKEN gh "$@"
}

manage_key() {
  require_macos
  require_command gh
  require_command ssh-keygen

  account=$(gh_stored api user --jq .login) || fail 'Authenticate the stored GitHub CLI session with gh auth login.'
  [ -n "$account" ] || fail 'The stored GitHub CLI session has no account.'

  mkdir -p "$key_dir"
  chmod 700 "$config_root" "$config_root/keys" "$key_dir"

  if [ ! -f "$private_key" ]; then
    if [ -e "$private_key" ] || [ -e "$public_key" ] || [ -e "$key_title_file" ]; then
      fail 'Refusing to replace incomplete existing key material.'
    fi
    title="agentbox/$(scutil --get LocalHostName)/$machine"
    ssh-keygen -q -t ed25519 -N '' -C "$title" -f "$private_key"
    printf '%s\n' "$title" >"$key_title_file"
    chmod 600 "$private_key" "$key_title_file"
  fi

  [ -f "$key_title_file" ] || fail 'The existing key is missing its original title.'
  title=$(cat "$key_title_file")
  [ -n "$title" ] || fail 'The existing key title is empty.'
  public_output=$(ssh-keygen -y -P '' -f "$private_key" 2>/dev/null) || fail 'The existing key must be an unencrypted Ed25519 private key.'
  public=$(printf '%s\n' "$public_output" | awk '{ print $1 " " $2 }')
  case $public in
    'ssh-ed25519 '*)
      ;;
    *)
      fail 'The existing key must be an unencrypted Ed25519 private key.'
      ;;
  esac

  public_tmp=$(mktemp "$key_dir/.github_ed25519.pub.XXXXXX")
  printf '%s %s\n' "$public" "$title" >"$public_tmp"
  chmod 644 "$public_tmp"
  mv -f "$public_tmp" "$public_key"

  registered_output=$(gh_stored api user/keys --paginate --jq '.[].key') || fail 'Could not inspect registered GitHub keys.'
  registered=$(printf '%s\n' "$registered_output" | awk '{ print $1 " " $2 }')
  if ! printf '%s\n' "$registered" | grep -Fqx "$public"; then
    gh_stored api --method POST user/keys -f "title=$title" -f "key=$public" >/dev/null || fail 'Could not register the dedicated GitHub key.'
  fi
}

install_ssh_alias() {
  old_alias_content='Host workbox
    HostName orb
    User workbox'
  previous_alias_content='Host workbox
    HostName 127.0.0.1
    Port 32222
    User workbox
    IdentityFile ~/.orbstack/ssh/id_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile ~/.orbstack/ssh/known_hosts'
  alias_content='Host workbox
    HostName 127.0.0.1
    Port 32222
    User workbox
    IdentityFile ~/.orbstack/ssh/id_ed25519
    IdentitiesOnly yes
    ForwardAgent no
    UserKnownHostsFile ~/.orbstack/ssh/known_hosts'

  mkdir -p "$ssh_dir/config.d"
  chmod 700 "$ssh_dir" "$ssh_dir/config.d"

  if [ -L "$ssh_alias" ]; then
    fail 'Refusing to replace a symlinked Agentbox SSH alias file.'
  fi
  write_alias=true
  if [ -e "$ssh_alias" ]; then
    if [ ! -f "$ssh_alias" ]; then
      fail 'Refusing to replace a conflicting Agentbox SSH alias file.'
    fi
    current_alias=$(cat "$ssh_alias")
    if [ "$current_alias" = "$alias_content" ]; then
      write_alias=false
    elif [ "$current_alias" != "$old_alias_content" ] && [ "$current_alias" != "$previous_alias_content" ]; then
      fail 'Refusing to replace a conflicting Agentbox SSH alias file.'
    fi
  fi

  if [ "$write_alias" = true ]; then
    alias_tmp=$(mktemp "$ssh_dir/config.d/.agentbox.XXXXXX")
    printf '%s\n' "$alias_content" >"$alias_tmp"
    chmod 600 "$alias_tmp"
    mv "$alias_tmp" "$ssh_alias"
  fi

  if [ -L "$ssh_config" ]; then
    fail 'Refusing to edit a symlinked main SSH config.'
  fi
  include='Include ~/.ssh/config.d/agentbox'
  if [ -e "$ssh_config" ] && [ ! -f "$ssh_config" ]; then
    fail 'Refusing to edit a non-file main SSH config.'
  fi
  if [ -f "$ssh_config" ] && grep -Fx "$include" "$ssh_config" >/dev/null; then
    return
  fi

  config_tmp=$(mktemp "$ssh_dir/.config.XXXXXX")
  printf '%s\n' "$include" >"$config_tmp"
  if [ -f "$ssh_config" ] && [ -s "$ssh_config" ]; then
    printf '\n' >>"$config_tmp"
    cat "$ssh_config" >>"$config_tmp"
  fi
  chmod 600 "$config_tmp"
  mv "$config_tmp" "$ssh_config"
}

machine_exists() {
  orb list -q 2>/dev/null | grep -Fx "$machine" >/dev/null
}

configure_machine_resources() {
  orb config set "machine.$machine.cpu" "$cpu_limit"
  orb config set "machine.$machine.memory_mib" "$memory_limit_mib"
  orb config set "machine.$machine.disk_bytes" "$disk_limit_bytes"
}

validate_machine() {
  require_command jq
  info=$(orb info "$machine" -f json 2>/dev/null) || fail 'Could not inspect the existing workbox machine.'
  actual_distribution=$(printf '%s\n' "$info" | jq -r '.record.image.distro')
  actual_version=$(printf '%s\n' "$info" | jq -r '.record.image.version')
  actual_architecture=$(printf '%s\n' "$info" | jq -r '.record.image.arch')
  expected_distribution=${distribution%%:*}
  [ "$actual_distribution" = "$expected_distribution" ] || fail 'The existing workbox distribution does not match its template.'
  case $distribution in
    *:*)
      expected_version=${distribution#*:}
      [ "$actual_version" = "$expected_version" ] || fail 'The existing workbox version does not match its template.'
      ;;
  esac
  [ "$actual_architecture" = "$architecture" ] || fail 'The existing workbox architecture does not match its template.'

  isolated=$(orb config get "machine.$machine.isolated" 2>/dev/null) || fail 'Could not inspect workbox isolation.'
  network_isolated=$(orb config get "machine.$machine.isolate_network" 2>/dev/null) || fail 'Could not inspect workbox network isolation.'
  agent_forwarded=$(orb config get "machine.$machine.forward_ssh_agent" 2>/dev/null) || fail 'Could not inspect workbox SSH-agent forwarding.'
  mounts=$(orb config get "machine.$machine.mounts" 2>/dev/null) || fail 'Could not inspect workbox mounts.'
  lan_exposure=$(orb config get machines.expose_ports_to_lan 2>/dev/null) || fail 'Could not inspect OrbStack LAN exposure.'

  [ "$isolated" = true ] || fail 'The existing workbox is not isolated.'
  [ "$network_isolated" = true ] || fail 'The existing workbox network is not isolated.'
  [ "$agent_forwarded" = false ] || fail 'The existing workbox forwards the host SSH agent.'
  if [ -n "$mounts" ] && [ "$mounts" != '[]' ]; then
    fail 'The existing workbox has host mounts.'
  fi
  [ "$lan_exposure" = false ] || fail 'OrbStack exposes guest ports to the LAN.'
}

create_machine() {
  load_machine_template
  validate_manifest
  require_orb
  if machine_exists; then
    validate_machine
    configure_machine_resources
    manage_key
    install_ssh_alias
    return
  fi

  manage_key
  install_ssh_alias
  orb config set machines.expose_ports_to_lan false
  orb create \
    --isolated \
    --isolate-network \
    --arch "$architecture" \
    --cpus "$cpu_limit" \
    --memory "${memory_limit_mib}M" \
    --disk "${disk_limit_gib}G" \
    "$distribution" \
    "$machine"
}

rebuild_machine() {
  load_machine_template
  validate_manifest
  require_orb
  machine_exists || fail 'The workbox machine does not exist.'
  manage_key
  install_ssh_alias
  [ -t 0 ] && [ -t 1 ] || fail 'Rebuild requires an interactive terminal.'

  printf 'Rebuilding workbox permanently deletes all guest state.\n' >&2
  printf 'Type workbox to continue: ' >&2
  IFS= read -r confirmation
  [ "$confirmation" = "$machine" ] || fail 'Rebuild cancelled.'

  orb delete --force "$machine"
  orb config set machines.expose_ports_to_lan false
  orb create \
    --isolated \
    --isolate-network \
    --arch "$architecture" \
    --cpus "$cpu_limit" \
    --memory "${memory_limit_mib}M" \
    --disk "${disk_limit_gib}G" \
    "$distribution" \
    "$machine"
}

[ "$#" -gt 0 ] || usage
command=$1
shift

case $command in
  create)
    [ "$#" -eq 0 ] || usage
    create_machine
    ;;
  key)
    [ "$#" -eq 0 ] || usage
    manage_key
    ;;
  sync-repos)
    sync_repositories "$@"
    ;;
  shell)
    require_orb
    if [ "$#" -eq 0 ]; then
      orbctl run --machine "$machine"
    else
      orbctl run --machine "$machine" /usr/bin/env -- "$@"
    fi
    ;;
  start)
    [ "$#" -eq 0 ] || usage
    require_orb
    orb start "$machine"
    ;;
  stop)
    [ "$#" -eq 0 ] || usage
    require_orb
    orb stop "$machine"
    ;;
  status)
    [ "$#" -eq 0 ] || usage
    require_orb
    orb info "$machine"
    ;;
  rebuild)
    [ "$#" -eq 0 ] || usage
    rebuild_machine
    ;;
  *)
    usage
    ;;
esac
