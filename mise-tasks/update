#!/bin/sh
#MISE description="Update managed repositories, packages, and plugins"
set -eu

script=$(realpath "$0")
repo=$(dirname "$(dirname "$script")")
cd "$repo"

printf '\n== managed repositories ==\n'
mise bootstrap repos update --yes

printf '\n== native packages ==\n'
mise bootstrap packages upgrade --yes

printf '\n== agent skills and integrations ==\n'
mise run bootstrap

printf '\n== LazyVim plugins ==\n'
nvim --headless "+Lazy! sync" +qa

printf '\n== verification ==\n'
mise run verify
