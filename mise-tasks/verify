#!/bin/sh
#MISE description="Verify the managed development environment"
set -eu

section() {
  printf '\n== %s ==\n' "$1"
}

check_homebrew_tool() {
  tool=$1
  active=$(command -v "$tool")
  managed=$brew_bin/$tool
  printf '%s\n' "$active"
  printf '%s\n' "$managed"
  test "$(realpath "$active")" = "$(realpath "$managed")"
}

script=$(realpath "$0")
repo=$(dirname "$(dirname "$script")")
cd "$repo"

case $(uname -s) in
  Darwin)
    platform=macos
    brew_bin=$(brew --prefix)/bin
    PATH=$brew_bin:$PATH
    export PATH
    ;;
  Linux)
    platform=linux
    ;;
  *)
    printf 'Unsupported platform: %s\n' "$(uname -s)" >&2
    exit 1
    ;;
esac

section "mise"
mise --version
mise tasks validate --errors-only
test "$(realpath "$HOME/.config/mise/config.toml")" = "$repo/mise.toml"
test "$(realpath "$HOME/.config/mise/config.$platform.toml")" = "$repo/mise.$platform.toml"
test "$(cat "$HOME/.config/mise/miserc.toml")" = "auto_env = true"

section "managed repositories"
mise bootstrap repos status --missing
test -r "$HOME/.oh-my-zsh/oh-my-zsh.sh"
skills_repo=$HOME/coding/skills
test -r "$skills_repo/.claude-plugin/marketplace.json"
test -r "$skills_repo/skills/task-implement/SKILL.md"
test "$(realpath "$HOME/.agents/AGENTS.md")" = "$skills_repo/config/global-agents.md"
test "$(realpath "$HOME/.agents/skills/pfleidi")" = "$skills_repo"
test "$(realpath "$HOME/.claude/CLAUDE.md")" = "$skills_repo/config/global-agents.md"
test ! -e "$HOME/.codex/AGENTS.md"
test ! -L "$HOME/.codex/AGENTS.md"

section "managed tools"
if [ "$platform" = macos ]; then
  for tool in nvim go gopls rg delta hunk fd tree-sitter starship direnv herdr lazygit git-lfs tmux claude codex orb; do
    check_homebrew_tool "$tool"
  done
  test -r "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  test -x "$(dirname "$(realpath "$brew_bin/codex")")/codex-code-mode-host"
else
  for tool in nvim go gopls node pnpm rg delta hunk fd tree-sitter starship direnv herdr lazygit git-lfs tmux claude codex entire gh jq yq shellcheck; do
    command -v "$tool"
  done
  test -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

nvim --version
go version
gopls version
rg --version
delta --version
hunk --version
fd --version
tree-sitter --version
starship --version
starship prompt --status 0 --jobs 0 --path "$repo" >/dev/null
direnv version
herdr --version
lazygit --version
git lfs version
tmux -V
claude --version
codex --version
if [ "$platform" = linux ]; then
  node --version
  pnpm --version
  entire version
  gh --version
  jq --version
  yq --version
  shellcheck --version
fi

section "personal agent skills"
claude plugin validate "$skills_repo"
marketplaces=$(claude plugin marketplace list --json)
printf '%s\n' "$marketplaces" | rg --fixed-strings "\"path\": \"$skills_repo\""
claude plugin details pfleidi@pfleidi

section "Vim"
test "$(realpath "$HOME/.vimrc")" = "$repo/config/vim/vimrc"
if [ "$platform" = macos ]; then
  test "$(realpath "$HOME/Library/Application Support/lazygit/config.yml")" = "$repo/config/lazygit/config.yml"
  test "$(realpath "$HOME/.config/git/config.platform")" = "$repo/config/git/macos"
else
  test "$(realpath "$HOME/.config/lazygit/config.yml")" = "$repo/config/lazygit/config.yml"
fi
vim -Nu "$repo/config/vim/vimrc" -n -es \
  "+call assert_equal('retrobox', g:colors_name)" \
  "+call assert_equal('rg --vimgrep --smart-case', &grepprg)" \
  "+call assert_equal(0, &relativenumber) | call assert_equal(3, g:netrw_liststyle) | call assert_equal(fnamemodify(&undodir, ':h:h'), g:netrw_home)" \
  "+call assert_equal(2, exists(':Lexplore'))" \
  "+call assert_equal(1, exists('g:loaded_EditorConfig'))" \
  "+call assert_equal(1, exists('g:loaded_matchit'))" \
  "+call assert_false(empty(maparg('gc', 'n')))" \
  "+if !empty(v:errors) | cquit | endif" \
  +qa

section "Neovim"
nvim --headless "+lua assert(not vim.wo.relativenumber)" "+lua assert(LazyVim.has_extra('lang.go'))" "+lua assert(LazyVim.opts('nvim-lspconfig').servers.gopls.mason == false)" "+Lazy! load codediff.nvim" "+lua assert(vim.fn.exists(':CodeDiff') == 2)" +qa

section "Herdr"
herdr config check
integration_status=$(herdr integration status)
printf '%s\n' "$integration_status"
printf '%s\n' "$integration_status" | rg '^claude: current '
printf '%s\n' "$integration_status" | rg '^codex: current '

section "bootstrap"
mise bootstrap status

section "Git diff"
git diff --check
